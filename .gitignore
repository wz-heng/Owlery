.env
.venv
__pycache__/
*.pyc
# No trailing slash: a bare `node_modules/` matches the directory but NOT a
# *symlink* named `node_modules` (a common dev shortcut for a shared install).
# One such symlink slipped past the slashed rule and got committed; this form
# ignores both.
node_modules
web/dist/
web/test-results/
test-results/
.claude/
.pytest_cache/
owlery.db*
owlery-dev.db*
# Pre-rename database files (docs/plans/rename-owlery.md) — still ignored so a
# checkout that hasn't yet booted the renamed build can't commit one.
octopus.db*
octopus-dev.db*
*.egg-info/

# Intermediate file from `bun run generate:contracts`
web/.openapi.json
